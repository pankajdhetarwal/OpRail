# .env — OpRail configuration
# Copy this file to .env and fill in values

DATABASE_URL=postgresql+psycopg2://oprail:oprail123@localhost:5432/oprail_db
# For SQLite (development fallback): sqlite:///./oprail.db

GEMINI_API_KEY=your_gemini_api_key_here

SECRET_KEY=supersecretkey_change_in_production
ENVIRONMENT=development

# Priority engine weights (tunable)
SEVERITY_WEIGHT=0.40
OVERDUE_WEIGHT=0.30
TRAIN_DENSITY_WEIGHT=0.15
ASSET_CRITICALITY_WEIGHT=0.15
